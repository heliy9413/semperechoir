{
  "name": "OutreachLog",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "location": {
      "type": "string",
      "title": "Target Location (\u1266\u1273)"
    },
    "event_date": {
      "type": "string",
      "title": "Event Date",
      "format": "date"
    },
    "participants_count": {
      "type": "number",
      "title": "Participants Count",
      "default": 0
    },
    "results": {
      "type": "string",
      "title": "Ministry Results / Notes"
    },
    "logged_by_name": {
      "type": "string",
      "title": "Logged By"
    }
  },
  "required": [
    "project_id",
    "location"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "super_admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "dept_admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "super_admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "dept_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "super_admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "dept_admin"
          }
        }
      ]
    }
  }
}