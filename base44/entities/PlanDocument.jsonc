{
  "name": "PlanDocument",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Document Title",
      "default": "\u12e8\u1230\u1295\u1354\u122d \u12a0\u121d\u120d\u12ae \u1205\u1265\u1228\u1275 \u12d3\u1218\u1273\u12ca \u12d5\u1245\u12f5 \u1230\u1290\u12f5"
    },
    "leader_name": {
      "type": "string",
      "title": "Choir Leader Name",
      "default": "\u1200\u12ed\u1208\u12a0\u1265 \u12f0\u121d\u1234 \u12a5\u1293 \u1270\u1235\u134b\u1290\u123d \u1283\u12ed\u120c"
    },
    "approving_body": {
      "type": "string",
      "title": "Approving Body / Signatory"
    },
    "intro_html": {
      "type": "string",
      "title": "Intro / Vision Notes (HTML)"
    },
    "plan_rows_json": {
      "type": "string",
      "title": "Plan Rows (JSON)"
    },
    "attachments_json": {
      "type": "string",
      "title": "Attachments (JSON)"
    },
    "updated_by_name": {
      "type": "string",
      "title": "Last Updated By"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "super_admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "super_admin"
          }
        }
      ]
    }
  }
}