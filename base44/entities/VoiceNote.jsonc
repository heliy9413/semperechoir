{
  "name": "VoiceNote",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title (\u122d\u12d5\u1235)"
    },
    "file_url": {
      "type": "string",
      "title": "Audio File URL"
    },
    "file_uri": {
      "type": "string",
      "title": "Audio File URI"
    },
    "transcript": {
      "type": "string",
      "title": "Transcript (\u133d\u1201\u134d)"
    },
    "duration_sec": {
      "type": "number",
      "title": "Duration (sec)",
      "default": 0
    },
    "author_name": {
      "type": "string",
      "title": "Author Name"
    },
    "status": {
      "type": "string",
      "title": "Transcription Status",
      "enum": [
        "pending",
        "processing",
        "done",
        "error"
      ],
      "default": "pending"
    }
  },
  "required": [
    "title",
    "file_url"
  ],
  "rls": {
    "read": null,
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "super_admin"
          }
        }
      ]
    }
  }
}