{
  "name": "Poll",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "title": "Poll Question"
    },
    "options_json": {
      "type": "string",
      "title": "Options (JSON array of strings)"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "open",
        "closed"
      ],
      "default": "open"
    },
    "created_by_name": {
      "type": "string",
      "title": "Created By"
    },
    "created_by_id": {
      "type": "string",
      "title": "Created By ID"
    },
    "created_at": {
      "type": "string",
      "title": "Created At (ISO)"
    }
  },
  "required": [
    "question",
    "options_json"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "super_admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "dept_admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "super_admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "dept_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "super_admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "dept_admin"
          }
        }
      ]
    }
  }
}