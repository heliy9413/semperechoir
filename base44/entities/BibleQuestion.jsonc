{
  "name": "BibleQuestion",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "title": "\u12e8\u1325\u12eb\u1244\u12cd \u133d\u1201\u134d"
    },
    "options_json": {
      "type": "string",
      "title": "\u12a0\u121b\u122b\u132e\u127d (JSON \u12e84 \u1210\u1228\u130e\u127d \u12f5\u122d\u12f5\u122d)"
    },
    "answer_index": {
      "type": "number",
      "title": "\u1275\u12ad\u12ad\u1208\u129b\u12cd \u12e8\u121d\u122d\u132b \u121b\u12cd\u1323\u1275 (0-3)",
      "default": 0
    },
    "scripture_ref": {
      "type": "string",
      "title": "\u12e8\u1218\u133d\u1210\u134d \u1245\u12f1\u1235 \u1325\u1245\u1235 \u121b\u1323\u1240\u123b"
    },
    "category": {
      "type": "string",
      "title": "\u121d\u12f5\u1265",
      "enum": [
        "\u1265\u1209\u12ed \u12aa\u12f3\u1295",
        "\u12a0\u12f2\u1235 \u12aa\u12f3\u1295",
        "\u1218\u12dd\u1219\u122d\u1293 \u121d\u1235\u130b\u1293",
        "\u12a0\u1320\u1243\u120b\u12ed"
      ],
      "default": "\u12a0\u1320\u1243\u120b\u12ed"
    },
    "difficulty": {
      "type": "string",
      "title": "\u12a5\u1295\u1245\u134b\u1275",
      "enum": [
        "\u1240\u120b\u120d",
        "\u1218\u12ab\u12a8\u1208\u129b",
        "\u12a8\u1263\u12f5"
      ],
      "default": "\u1240\u120b\u120d"
    }
  },
  "required": [
    "question",
    "options_json",
    "answer_index"
  ],
  "rls": {
    "read": null,
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "super_admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "dept_admin",
            "data.department": "\u12e8\u1338\u120e\u1275 \u12ad\u134d\u120d"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "super_admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "dept_admin",
            "data.department": "\u12e8\u1338\u120e\u1275 \u12ad\u134d\u120d"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "super_admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "dept_admin",
            "data.department": "\u12e8\u1338\u120e\u1275 \u12ad\u134d\u120d"
          }
        }
      ]
    }
  }
}