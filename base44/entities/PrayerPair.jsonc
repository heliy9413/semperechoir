{
  "name": "PrayerPair",
  "type": "object",
  "properties": {
    "eth_year": {
      "type": "number",
      "title": "Ethiopian Year"
    },
    "month_index": {
      "type": "number",
      "title": "Ethiopian Month Index (0-11)"
    },
    "pairs_json": {
      "type": "string",
      "title": "Pairs (JSON array of {a:{id,name}, b:{id,name}|null})"
    },
    "generated_by_name": {
      "type": "string",
      "title": "Generated By"
    },
    "generated_at": {
      "type": "string",
      "title": "Generated At (ISO)"
    }
  },
  "required": [
    "eth_year",
    "month_index",
    "pairs_json"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "super_admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "dept_admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "super_admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "dept_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "super_admin"
          }
        },
        {
          "user_condition": {
            "data.choir_role": "dept_admin"
          }
        }
      ]
    }
  }
}